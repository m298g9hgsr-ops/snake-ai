"""蛇3310 AI 自動化 — 純鍵盤操控，不碰 pyautogui 滑鼠"""
import subprocess, time, ctypes, sys

user32 = ctypes.windll.user32
# Disable pyautogui failsafe
try:
    import pyautogui
    pyautogui.FAILSAFE = False
except: pass

VK_LEFT, VK_DOWN, VK_RIGHT, VK_UP = 0x25, 0x28, 0x27, 0x26
GAME_ID = "57365.3310_0bde4r8renxae"

def find_game():
    return user32.FindWindowW(None, '貪食蛇3310')

def resize_window(hwnd, w=520, h=900):
    sw = user32.GetSystemMetrics(0); sh = user32.GetSystemMetrics(1)
    x = (sw - w) // 2; y = (sh - h) // 2
    user32.SetWindowPos(hwnd, None, x, y, w, h, 0x0040 | 0x0002)
    time.sleep(0.2)

def set_foreground(hwnd):
    if not hwnd: return False
    tid = user32.GetWindowThreadProcessId(hwnd, None)
    ftid = user32.GetWindowThreadProcessId(user32.GetForegroundWindow(), None)
    try: user32.AttachThreadInput(tid, ftid, True)
    except: pass
    user32.SetForegroundWindow(hwnd)
    user32.BringWindowToTop(hwnd)
    try: user32.AttachThreadInput(tid, ftid, False)
    except: pass
    return True

def send_key(vk):
    """Global keyboard event — works with UWP."""
    user32.keybd_event(vk, 0, 0, 0)   # WM_KEYDOWN
    time.sleep(0.02)
    user32.keybd_event(vk, 0, 2, 0)   # WM_KEYUP
    time.sleep(0.03)

def restart_game():
    global GAME_ID
    subprocess.run(['powershell', '-Command',
        'Stop-Process -Name "貪食蛇3310" -Force -ErrorAction SilentlyContinue'],
        capture_output=True, timeout=10)
    time.sleep(1)
    subprocess.Popen(['explorer.exe', f'shell:AppsFolder\{GAME_ID}'])
    time.sleep(3)
    hwnd = find_game()
    if hwnd:
        set_foreground(hwnd)
        resize_window(hwnd)
        print(f"重啟: {hwnd}")
        return hwnd
    print("重啟失敗")
    return None

def get_snake_state():
    venv = r'C:\Users\STKRPNFAD-NCHQW\AppData\Local\hermes\installs\4ae13c26679c192f\environments\acf03d9a2a2c4d018f733a48e918c365\venv\Scripts\python'
    try:
        r = subprocess.run([venv, 'check_state.py'], capture_output=True, text=True, timeout=10,
            cwd=r'C:\Users\STKRPNFAD-NCHQW\Desktop')
        return r.stdout.strip()
    except Exception as e:
        return f"Error: {e}"

def main():
    hwnd = find_game()
    if not hwnd:
        print("Game not found — launching...")
        subprocess.Popen(['explorer.exe', f'shell:AppsFolder\{GAME_ID}'])
        time.sleep(4)
        hwnd = find_game()
    if not hwnd:
        print("ERROR: Game not found!")
        return
    print(f"Game found: {hwnd}")
    set_foreground(hwnd)
    resize_window(hwnd)
    time.sleep(0.5)

    n = 8
    seq = [(VK_LEFT, n), (VK_DOWN, n), (VK_RIGHT, n+1), (VK_UP, n+1)]
    idx = 0
    print("蛇3310 AI 啟動（純鍵盤）")
    print("Ctrl+C to stop")

    while True:
        try:
            vk, steps = seq[idx % 4]
            name = {VK_LEFT:'左', VK_DOWN:'下', VK_RIGHT:'右', VK_UP:'上'}[vk]
            for _ in range(steps):
                send_key(vk)
                time.sleep(0.08)
            idx += 1
            state = get_snake_state()
            print(f"{name} {steps}步 | {state}")
            if 'Snake: 0 pixels' in state or 'Error' in state:
                print("蛇死了！重啟...")
                hwnd = restart_game()
                idx = 0  # reset spiral
                time.sleep(1)
        except KeyboardInterrupt:
            print("\nStopped.")
            break
        except Exception as e:
            print(f"Err: {e}")
            time.sleep(0.5)

if __name__ == '__main__':
    main()
